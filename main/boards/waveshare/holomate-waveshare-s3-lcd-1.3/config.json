{
    "manufacturer": "waveshare",
    "target": "esp32s3",
    "builds": [
        {
            "name": "holomate-waveshare-s3-lcd-1.3",
            "idf_version": ">=6.0",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_HOLOMATE_WAVESHARE_S3_LCD_1_3=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m.csv\"",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_80M=y",
                "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y",
                "CONFIG_USE_AUDIO_PROCESSOR=y",
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_USE_SERVER_AEC=n",
                "CONFIG_USE_AFE_WAKE_WORD=y",
                "CONFIG_SEND_WAKE_WORD_DATA=n",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                "CONFIG_SR_WN_WN9_JARVIS_TTS=y",
                "CONFIG_USE_DEFAULT_MESSAGE_STYLE=y",
                "CONFIG_ESP_CONSOLE_UART_DEFAULT=y",
                "CONFIG_ESP_CONSOLE_SECONDARY_NONE=y",
                "CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n"
            ]
        }
    ]
}
